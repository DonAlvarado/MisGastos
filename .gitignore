
# ==========================================
# MisGastos - Git Ignore
# ==========================================

# Dependencias
node_modules/
**/node_modules/

# Compilados y archivos generados
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/
*.tsbuildinfo
.vite/
**/.vite/

# Secretos y variables de entorno
.env
.env.*
**/.env
**/.env.*

# Permitir ejemplos de configuración
!.env.example
!**/.env.example

# PostgreSQL y respaldos locales
pgdata/
**/pgdata/
postgres_data/
**/postgres_data/
*.dump
*.backup
*.bak
*.sql.gz

# Docker (archivos temporales locales)
docker-data/
**/docker-data/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Archivos temporales
*.tmp
*.temp
.cache/
**/.cache/

# Archivos de pruebas
playwright-report/
test-results/
